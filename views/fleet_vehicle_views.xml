<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- 1. Vista Formulario para el Documento (Independiente) -->
    <record id="view_fleet_sharepoint_document_form" model="ir.ui.view">
        <field name="name">fleet.sharepoint.document.form</field>
        <field name="model">fleet.sharepoint.document</field>
        <field name="arch" type="xml">
            <form string="Subir Documento">
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="Ej. Tarjeta de Propiedad"/>
                            <field name="filename" invisible="True"/>
                            <!-- Aquí usamos widget="binary" y el validador ya sabe que filename pertenece a este modelo -->
                            <field name="upload_file" filename="filename" widget="binary"/>
                        </group>
                        <group>
                            <field name="sp_item_id" readonly="True" groups="base.group_no_one"/>
                            <field name="mimetype" invisible="True"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 2. Vista Lista para el Documento -->
    <record id="view_fleet_sharepoint_document_list" model="ir.ui.view">
        <field name="name">fleet.sharepoint.document.list</field>
        <field name="model">fleet.sharepoint.document</field>
        <field name="arch" type="xml">
            <!-- AQUÍ ESTÁ EL CAMBIO CLAVE -->
            <list string="Documentos">
                <field name="name"/>
                <field name="filename" invisible="True"/>
                <field name="mimetype" invisible="True"/>
                <button name="action_view_document" 
                        type="object" 
                        string="Ver Documento" 
                        icon="fa-eye" 
                        class="btn-primary"/>
            </list>
        </field>
    </record>

    <!-- 3. Heredamos el formulario principal del Vehículo -->
    <record id="view_fleet_vehicle_form_inherit_sharepoint" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit.sharepoint</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Documentos SharePoint" name="sharepoint_documents">
                    <!-- Odoo usará automáticamente las vistas form y list declaradas arriba -->
                    <field name="sharepoint_document_ids"/>
                </page>
            </xpath>
        </field>
    </record>

</odoo>