<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- 1. Vista Formulario para el Documento -->
    <record id="view_fleet_sharepoint_document_form" model="ir.ui.view">
        <field name="name">fleet.sharepoint.document.form</field>
        <field name="model">fleet.sharepoint.document</field>
        <field name="arch" type="xml">
            <form string="Subir Documento" duplicate="0">
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="Ej. Tarjeta de Propiedad"/>
                            <field name="filename" invisible="True"/>
                            <field name="upload_file" filename="filename" widget="binary"/>
                        </group>
                        <group>
                            <field name="sp_item_id" readonly="True" groups="base.group_no_one"/>
                            <field name="mimetype" invisible="True"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 2. Vista Lista Completa para el Documento (Soporta Checkboxes y Selección Masiva) -->
    <record id="view_fleet_sharepoint_document_list" model="ir.ui.view">
        <field name="name">fleet.sharepoint.document.list</field>
        <field name="model">fleet.sharepoint.document</field>
        <field name="arch" type="xml">
            <list string="Documentos SharePoint" multi_edit="1" duplicate="0">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="filename" invisible="True"/>
                <field name="mimetype" invisible="True"/>
                <!-- Botón de Vista (Modal) -->
                <button name="action_view_document" type="object" string="Ver" icon="fa-eye" class="btn-primary"/>
                <!-- Botón de Descarga Individual -->
                <button name="action_download_document" type="object" string="Descargar" icon="fa-download" class="btn-secondary"/>
                <!-- Botón de Compartir Link -->
                <button name="action_share_document" type="object" string="Compartir" icon="fa-share-alt" class="btn-info"/>
            </list>
        </field>
    </record>

    <!-- 3. Acción de Ventana para el Smart Button -->
    <record id="action_fleet_sharepoint_document_smart" model="ir.actions.act_window">
        <field name="name">Documentos SharePoint</field>
        <field name="res_model">fleet.sharepoint.document</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('vehicle_id', '=', active_id)]</field>
        <field name="context">{'default_vehicle_id': active_id}</field>
    </record>

    <!-- Acción de Servidor para Descargar ZIP -->
    <record id="action_sharepoint_mass_download" model="ir.actions.server">
        <field name="name">Descargar como ZIP</field>
        <field name="model_id" ref="model_fleet_sharepoint_document"/>
        <field name="binding_model_id" ref="model_fleet_sharepoint_document"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            # Redirigimos al controlador pasando los IDs seleccionados
            action = {
                'type': 'ir.actions.act_url',
                'url': '/sharepoint/download_zip?ids=%s' % ','.join(map(str, records.ids)),
                'target': 'self',
            }
        </field>
    </record>

    <!-- 4. Heredamos la Ficha del Vehículo para insertar el Smart Button y mantener la Pestaña -->
    <record id="view_fleet_vehicle_form_inherit_sharepoint" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit.sharepoint</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            
            <!-- Insertamos el Smart Button en la caja superior del vehículo -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(action_fleet_sharepoint_document_smart)d" 
                        type="action" 
                        class="oe_stat_button" 
                        icon="fa-folder-open">
                    <field name="sharepoint_doc_count" widget="statinfo" string="Documentos SP"/>
                </button>
            </xpath>

            <!-- Pestaña dentro del formulario del vehículo -->
            <xpath expr="//notebook" position="inside">
                <page string="Documentos SharePoint" name="sharepoint_documents">
                    <field name="sharepoint_document_ids"/>
                </page>
            </xpath>
        </field>
    </record>

</odoo>